{
  "name": "canvas-tic-tac-toe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tic-tac-toe against the computer on a rotating Canvas cube under a hand-painted night sky.",
  "engines": {
    "node": ">=22.12.0"
