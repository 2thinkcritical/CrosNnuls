{
  "name": "canvas-tic-tac-toe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Canvas Tic-Tac-Toe game with a rotating cube and an optional Telegram adapter.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json",
    "worker:dev": "wrangler dev --ip 127.0.0.1 --port 8081",
    "worker:check": "wrangler deploy --dry-run --outdir .worker-build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261128.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "7.0.2",
    "wrangler": "4.168.0"
  },
  "license": "MIT"
}
